{
  "name": "pirate-cinema-desktop",
  "version": "0.5.4-local.1",
  "description": "Локальная медиатека и клиент TorrServer",
  "author": "Pirate Cinema",
  "main": "electron/main.mjs",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:local": "node scripts/dev-local.mjs",
    "api:local": "node --env-file-if-exists=.env.local server/api.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release --ignore-pattern release-web",
    "desktop:start": "electron .",
    "desktop:package": "node node_modules/vinext/dist/cli.js build && electron-builder --win nsis",
    "desktop:package:web": "node node_modules/vinext/dist/cli.js build && electron-builder --config electron-builder-web.yml --win nsis-web",
    "desktop:package:linux": "node node_modules/vinext/dist/cli.js build && electron-builder --config electron-builder-linux.yml --linux deb rpm",
    "desktop:package:arch": "node node_modules/vinext/dist/cli.js build && electron-builder --config electron-builder-arch.yml --linux tar.gz"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron-updater": "6.6.2",
    "ffmpeg-static": "5.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
