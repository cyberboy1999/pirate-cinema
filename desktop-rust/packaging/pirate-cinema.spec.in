Name: pirate-cinema
Version: @VERSION@
Release: 1%{?dist}
Summary: Local TorrServer media library written in Rust
License: GPL-3.0-only
Requires: mpv, gtk3, webkit2gtk4.1, libayatana-appindicator, xdotool
Source0: pirate-cinema.tar.gz

%description
Native local-first Pirate Cinema client for TorrServer and MPV.

%install
mkdir -p %{buildroot}
tar -xzf %{SOURCE0} -C %{buildroot}

%files
/opt/pirate-cinema
/usr/share/applications/pirate-cinema.desktop
/usr/share/icons/hicolor/256x256/apps/pirate-cinema.png
