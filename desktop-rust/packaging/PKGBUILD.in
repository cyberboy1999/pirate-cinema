pkgname=pirate-cinema
pkgver=@VERSION@
pkgrel=1
pkgdesc='Local TorrServer media library written in Rust'
arch=('x86_64')
url='https://github.com/cyberboy1999/pirate-cinema'
license=('GPL-3.0-only')
depends=('mpv' 'gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator' 'xdotool')
makedepends=('cargo' 'pkgconf')
source=("pirate-cinema-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        'TorrServer-linux-amd64::https://github.com/YouROK/TorrServer/releases/download/MatriX.144/TorrServer-linux-amd64')
sha256sums=('SKIP'
            'e93e3c3b85932eed4c98b61785fabe6379b1ee10d91998729cbdea3384af5f9d')

build() {
  cd "pirate-cinema-${pkgver}"
  cargo build --release --locked --manifest-path desktop-rust/Cargo.toml --bin pirate-cinema
}

package() {
  cd "pirate-cinema-${pkgver}"
  install -Dm755 desktop-rust/target/release/pirate-cinema "$pkgdir/opt/pirate-cinema/pirate-cinema"
  install -Dm755 "$srcdir/TorrServer-linux-amd64" "$pkgdir/opt/pirate-cinema/torrserver/TorrServer-linux-amd64"
  install -Dm644 desktop-rust/packaging/pirate-cinema.desktop "$pkgdir/usr/share/applications/pirate-cinema.desktop"
  install -Dm644 public/favicon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/pirate-cinema.png"
}
