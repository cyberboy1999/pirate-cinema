# TorrServer (non-secret URL; credentials stay only in .env.local)
TORRSERVER_URL=http://127.0.0.1:8090
TORRSERVER_USERNAME=
TORRSERVER_PASSWORD=
TORR_LOCAL_API_PORT=3001

# Optional override. By default the bundled vendor/mpv/mpv.exe is used.
# MPV_PATH=C:\Program Files\mpv\mpv.exe

# TMDB metadata and posters. Prefer the Read Access Token.
# Leave both empty to use the bundled local demo metadata.
TMDB_READ_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=ru-RU
